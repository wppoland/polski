msgstr "您必须接受隐私政策。"

msgid ""
"I have read and accept the <a href=\"%s\" target=\"_blank\">privacy "
"policy</a>."
msgstr "我已阅读并接受<a href=\"%s\" target=\"_blank\">隐私政策</a>。"

