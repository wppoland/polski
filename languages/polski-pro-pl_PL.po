#: src/Admin/ModulesPage.php:293
msgid ""
"VAT rate notice next to prices and small business exemption support (Art. "
"113 of the VAT Act). Whether prices show gross or net is set in WooCommerce "
"> Settings > Tax; the notice shows only when prices are displayed including "
"tax."
msgstr ""

#: src/Admin/ModulesPage.php:299
msgid "VAT notice text"
msgstr "Tekst informacji o VAT"

#: src/Admin/ModulesPage.php:299
msgid "Variables: {rate}"
msgstr "Zmienne: {rate}"

