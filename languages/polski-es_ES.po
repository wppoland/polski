#. Plugin Name of the plugin
#: polski.php src/Admin/DeactivationHandler.php:58 src/Admin/SBOMPage.php:113
msgid "Polski for WooCommerce"
msgstr "Polski para WooCommerce"

#. Plugin URI of the plugin
#: polski.php
msgid "https://plogins.com/polski/"
msgstr "https://plogins.com/es/polski/"

#. Description of the plugin
#: polski.php
msgid ""
"Adds GPSR, Omnibus, GDPR, withdrawals, VAT ID, KSeF hooks, product data and "
"storefront modules for Polish WooCommerce shops."
msgstr ""
"Añade GPSR, Omnibus, GDPR, devoluciones, NIP, ganchos KSeF, datos de "
"productos y módulos de tienda para las tiendas polacas WooCommerce."

