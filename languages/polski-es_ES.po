msgctxt "block title"
msgid "DSA report form"
msgstr "formulario de informe DSA"

#: blocks/dsa-report/block.json
msgctxt "block description"
msgid "A form for reporting illegal content under the Digital Services Act."
msgstr ""
"Un formulario para denunciar contenido ilegal según la Ley de Servicios "
"Digitales."

#: blocks/food-info/block.json
msgctxt "block title"
msgid "Food Information"
msgstr "Información alimentaria"

#: blocks/food-info/block.json
msgctxt "block description"
msgid "Displays food and grocery information for the current product."
msgstr ""
"Muestra información sobre alimentos y comestibles para el producto actual."

#: blocks/gpsr/block.json
msgctxt "block title"
msgid "GPSR safety information"
msgstr "Información de seguridad GPSR"

#: blocks/gpsr/block.json
msgctxt "block description"
msgid "Displays the GPSR product safety information for the current product."
msgstr ""
"Muestra la información de seguridad del producto GPSR para el producto "
"actual."

#: blocks/ingredients/block.json
msgctxt "block title"
msgid "Ingredients"
msgstr "Ingredientes"

#: blocks/ingredients/block.json
msgctxt "block description"
msgid "Displays the ingredients list for the current product."
msgstr "Muestra la lista de ingredientes del producto actual."

#: blocks/manufacturer/block.json
msgctxt "block title"
msgid "Manufacturer"
msgstr "Fabricante"

#: blocks/manufacturer/block.json
msgctxt "block description"
msgid ""
"Displays the manufacturer and EU responsible person details for the current "
"product."
msgstr ""
"Muestra los detalles del fabricante y de la persona responsable en la UE del "
"producto actual."

#: blocks/nutri-score/block.json
msgctxt "block title"
msgid "Nutri-Score"
msgstr "Puntuación nutricional"

#: blocks/nutri-score/block.json
msgctxt "block description"
msgid "Displays the Nutri-Score label for the current product."
msgstr "Muestra la etiqueta Nutri-Score del producto actual."

#: blocks/nutrients/block.json
msgctxt "block title"
msgid "Nutritional Information"
msgstr "Información nutricional"

#: blocks/nutrients/block.json
msgctxt "block description"
msgid "Displays the nutritional information for the current product."
msgstr "Muestra la información nutricional del producto actual."

#: blocks/omnibus-price/block.json
msgctxt "block title"
msgid "Lowest Price (Omnibus)"
msgstr "Precio más bajo (ómnibus)"

#: blocks/omnibus-price/block.json
msgctxt "block description"
msgid ""
"Displays the lowest price from the last 30 days (Omnibus) for the current "
"product."
msgstr ""
"Muestra el precio más bajo de los últimos 30 días (Omnibus) para el producto "
"actual."

#: blocks/payment-methods/block.json
msgctxt "block title"
msgid "Accepted payment methods"
msgstr "Métodos de pago aceptados"

#: blocks/payment-methods/block.json
msgctxt "block description"
msgid "Lists the payment methods available in your store."
msgstr "Enumera los métodos de pago disponibles en tu tienda."

#: blocks/power-supply/block.json
msgctxt "block title"
msgid "Power Supply"
msgstr "Fuente de alimentación"

#: blocks/power-supply/block.json
msgctxt "block description"
msgid "Displays the power supply information for the current product."
msgstr ""
"Muestra la información de la fuente de alimentación del producto actual."

#: blocks/safety-docs/block.json
msgctxt "block title"
msgid "Safety Documents"
msgstr "Documentos de seguridad"

#: blocks/safety-docs/block.json
msgctxt "block description"
msgid "Displays the safety documents and declarations for the current product."
msgstr ""
"Muestra los documentos y declaraciones de seguridad del producto actual."

#: blocks/safety-info/block.json
msgctxt "block title"
msgid "Safety Instructions"
msgstr "Instrucciones de seguridad"

#: blocks/safety-info/block.json
msgctxt "block description"
msgid "Displays the product safety instructions for the current product."
msgstr "Muestra las instrucciones de seguridad del producto actual."

#: blocks/shipping-notice/block.json
msgctxt "block title"
msgid "Shipping costs"
msgstr "Gastos de envío"

#: blocks/shipping-notice/block.json
msgctxt "block description"
msgid "Displays the shipping cost notice for the current product."
msgstr "Muestra el aviso de costo de envío del producto actual."

#: blocks/small-business-notice/block.json
msgctxt "block title"
msgid "Small business VAT notice"
msgstr "Aviso de IVA para pequeñas empresas"

#: blocks/small-business-notice/block.json
msgctxt "block description"
msgid ""
"Displays the VAT-exempt small business notice when your store is configured "
"as a small business."
msgstr ""
"Muestra el aviso de pequeña empresa exenta de IVA cuando tu tienda está "
"configurada como pequeña empresa."

#: blocks/tax-notice/block.json
msgctxt "block title"
msgid "Tax Information"
msgstr "Información fiscal"

#: blocks/tax-notice/block.json
msgctxt "block description"
msgid ""
"Displays the gross/net price and VAT tax information for the current product."
msgstr ""
"Muestra el precio bruto/neto y la información del IVA del producto actual."

#: blocks/unit-price/block.json
msgctxt "block title"
msgid "Unit Price"
msgstr "Precio unitario"

#: blocks/unit-price/block.json
msgctxt "block description"
msgid ""
"Displays the price per unit (per kg, litre, piece, etc.) for the current "
"product."
msgstr ""
"Muestra el precio unitario (por kg, litro, pieza, etc.) del producto actual."

#: blocks/withdrawal-form/block.json
msgctxt "block title"
msgid "Polski - Annex I(B) form template"
msgstr "Polski - Modelo de formulario del anexo I, parte B"

#: blocks/withdrawal-form/block.json
msgctxt "block description"
msgid ""
"The model withdrawal form template (Annex I(B)) pre-filled with merchant "
"data."
msgstr ""
"El modelo de plantilla de formulario de desistimiento (Anexo I(B)) "
"precargado con datos del comerciante."

#: blocks/withdrawal-info/block.json
msgctxt "block title"
msgid "Polski - Annex I(A) information"
msgstr "Polski - Información del anexo I(A)"

#: blocks/withdrawal-info/block.json
msgctxt "block description"
msgid ""
"Generated information about the consumer right of withdrawal (Annex I(A))."
msgstr ""
"Información generada sobre el derecho de desistimiento del consumidor (Anexo "
"I(A))."

#: blocks/withdrawal-lookup/block.json
msgctxt "block title"
msgid "Polski - withdrawal lookup"
msgstr "Polski - búsqueda de desistimientos"

#: blocks/withdrawal-lookup/block.json
msgctxt "block description"
msgid "Email + order number lookup form for guests to file a withdrawal."
msgstr ""
"Formulario de búsqueda de número de pedido y correo electrónico para que los "
"invitados presenten un desistimiento."

#: build/blocks/ajax-filters/block.json
msgctxt "block title"
msgid "Polski AJAX Filters"
msgstr "Filtros AJAX de Polski"

#: build/blocks/ajax-filters/block.json
msgctxt "block description"
msgid "Dynamic WooCommerce product filters with archive-safe GET fallback."
msgstr ""
"Filtros dinámicos de productos WooCommerce con respaldo GET seguro para "
"archivos."

#: build/blocks/ajax-search/block.json
msgctxt "block title"
msgid "Polski AJAX Search"
msgstr "Búsqueda AJAX de Polski"

#: build/blocks/ajax-search/block.json
msgctxt "block description"
msgid "Dynamic AJAX product search form for WooCommerce storefronts."
msgstr ""
"Formulario dinámico de búsqueda de productos AJAX para escaparates de "
"WooCommerce."

#: build/blocks/product-slider/block.json
msgctxt "block title"
msgid "Polski Product Slider"
msgstr "Control deslizante de productos Polski"

#: build/blocks/product-slider/block.json
msgctxt "block description"
msgid ""
"Dynamic merchandising slider for related, upsell, sale, and featured "
"products."
msgstr ""
"Control deslizante de comercialización dinámica para productos relacionados, "
"de ventas adicionales, en oferta y destacados."

