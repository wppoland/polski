#: src/Rest/CheckboxController.php:115 src/Rest/CheckboxController.php:177
msgid "Checkbox not found."
msgstr "Casilla de verificación no encontrada."

#: src/Rest/CheckboxController.php:130
msgid "Checkbox ID is required."
msgstr "Se requiere ID de casilla de verificación."

#: src/Rest/CheckboxController.php:139
msgid "Cannot create a checkbox with a reserved ID."
