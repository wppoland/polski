msgstr "Tiempo entre mostrar notificaciones consecutivas. Recomendado: 6-12"

#: src/Admin/ModulesPage.php:1541
msgid "Display duration (seconds)"
msgstr "Duración de la visualización (segundos)"

#: src/Admin/ModulesPage.php:1541
