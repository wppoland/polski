#: src/Service/SiteAuditService.php:856
msgid ""
"Only %1$d of %2$d tracked services have a data processing agreement marked."
msgstr ""
"Solo %1$d de %2$d servicios rastreados tienen marcado un acuerdo de "
"procesamiento de datos."

#. translators: %d: number of tracked services
#: src/Service/SiteAuditService.php:868
msgid ""
"DPA registry covers %d services and all have an agreement status marked."
msgstr ""
"El registro DPA cubre %d servicios y todos tienen marcado un estado de "
"acuerdo."

#: src/Service/SiteAuditService.php:881
msgid "Security incident registry"
msgstr "Registro de incidentes de seguridad"

#: src/Service/SiteAuditService.php:887
msgid ""
"Security incident module is disabled. It is good practice to maintain a "
"simple incident registry for compliance."
msgstr ""
"El módulo de incidentes de seguridad está deshabilitado. Es una buena "
"práctica mantener un registro de incidentes simple para el cumplimiento."

#: src/Service/SiteAuditService.php:901
msgid "Incident module is enabled, but no security contact email is set."
msgstr ""
"El módulo de incidentes está habilitado, pero no se establece ningún correo "
"electrónico de contacto de seguridad."

#: src/Service/SiteAuditService.php:909
msgid ""
"Incident module is enabled and security contact is set. The registry is "
"currently empty."
msgstr ""
"Se habilita el módulo de incidencias y se establece el contacto de "
"seguridad. El registro está actualmente vacío."

#. translators: %d: number of open incidents
#: src/Service/SiteAuditService.php:928
msgid ""
"There are %d open security incidents requiring further action in the "
