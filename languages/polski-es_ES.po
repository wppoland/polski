msgstr ""
"Hay %d incidentes de seguridad abiertos que requieren acciones adicionales "
"en el registro."

#: src/Service/SiteAuditService.php:931
msgid "The incident registry is active and has no open cases."
msgstr ""
"El registro de incidencias se encuentra activo y no tiene casos abiertos."

#: src/Service/SiteAuditService.php:942
msgid "SSL/TLS encryption"
msgstr "Cifrado SSL/TLS"

#: src/Service/SiteAuditService.php:948
