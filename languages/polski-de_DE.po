#. Plugin Name of the plugin
#: polski.php src/Admin/DeactivationHandler.php:58 src/Admin/SBOMPage.php:113
msgid "Polski for WooCommerce"
msgstr "Polski für WooCommerce"

#. Plugin URI of the plugin
#: polski.php
msgid "https://plogins.com/polski/"
msgstr "https://plogins.com/de/polski/"

#. Description of the plugin
#: polski.php
msgid ""
"Adds GPSR, Omnibus, GDPR, withdrawals, VAT ID, KSeF hooks, product data and "
"storefront modules for Polish WooCommerce shops."
msgstr ""
"Fügt GPSR, Omnibus, DSGVO, Retouren, NIP, KSEF-Hooks, Produktdaten und Shop-"
"Module für polnische WooCommerce-Shops hinzu."

