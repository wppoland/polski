#. Plugin Name of the plugin
#: polski.php src/Admin/DeactivationHandler.php:58 src/Admin/SBOMPage.php:113
msgid "Polski for WooCommerce"
msgstr "Polski pro WooCommerce"

#. Plugin URI of the plugin
#: polski.php
msgid "https://plogins.com/polski/"
msgstr "https://plogins.com/polski/"

#. Description of the plugin
#: polski.php
msgid ""
"Adds GPSR, Omnibus, GDPR, withdrawals, VAT ID, KSeF hooks, product data and "
"storefront modules for Polish WooCommerce shops."
msgstr ""
"Přidává GPSR, Omnibus, GDPR, vrácení zboží, NIP, háčky KSeF, údaje o "
"produktech a moduly obchodu pro polské obchody WooCommerce."

